{
  // このファイルは .gitignore で除外していない。チーム共有の対象とする（Docs/HANDOFF.md §8）。
  // 各自の環境依存の設定は .vscode/settings.local.json ではなく、ユーザー設定に置くこと。

  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",

  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.pytestArgs": ["Tests"],

  // 物理計算は SI 単位。桁数の多い数値を読み違えないよう、
  // ルーラーとインデント可視化を有効にしておく。
  "editor.rulers": [100],
  "editor.renderWhitespace": "boundary",

  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,

  "files.exclude": {
    "**/__pycache__": true,
    "**/.pytest_cache": true
  },
  "search.exclude": {
    ".venv": true,
    "**/__pycache__": true
  },

  // vehicle.json は最重要データ。折り返さずに読む
  "[json]": {
    "editor.wordWrap": "off",
    "editor.formatOnSave": false
  },

  // 仕様書は日本語の長文。折り返して読む
  "[markdown]": {
    "editor.wordWrap": "on",
    "files.trimTrailingWhitespace": false
  }
}
